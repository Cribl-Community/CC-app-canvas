# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# Forward /api/v1/* from the local dev server to a real Cribl instance.
# This lets you test API integrations without deploying to staging.
# Example: https://appplat-recursing-chaplygin-4o26sjd.cribl-staging.cloud
VITE_CRIBL_PROXY_TARGET=https://your-instance.cribl-staging.cloud

# Bearer token injected into every proxied request.
# Get it from your staging UI: open DevTools → Network → any /api/v1 request → copy the Authorization header value.
VITE_CRIBL_AUTH_TOKEN=Bearer eyJ...
